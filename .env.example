# Flask Uygulama Ayarlari (Bu dosyayi .env adiyla kopyalayip kendi degerlerinizi girin)
FLASK_APP=backend/main.py
FLASK_DEBUG=True
SECRET_KEY=

# Uygulama Kilidi (Application Lock) Ayarlari
# Ilk kurulum sifresini buradan veya ilk acilista /login ekranindan belirleyebilirsiniz
APP_LOCK_PASSWORD=
SESSION_TIMEOUT_MINUTES=10

# Veritabani ve Dosya Yollari
DB_PATH=database/expenses.db
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=5242880
